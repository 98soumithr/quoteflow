datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  quotes        Quote[]
  invoices      Invoice[]
}

model Quote {
  id              String      @id @default(cuid())
  userId          String
  customerId      String
  sellerState     String
  customerState   String
  notes           String?
  status          String      @default("DRAFT")
  subTotalPaise   Int
  gstAmountPaise  Int
  totalPaise      Int
  gstType         String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  lineItems LineItem[]
  invoice   Invoice?
}

model Invoice {
  id              String        @id @default(cuid())
  userId          String
  customerId      String
  quoteId         String?       @unique
  dueDate         DateTime
  status          String        @default("DRAFT")
  subTotalPaise   Int
  gstAmountPaise  Int
  totalPaise      Int
  gstType         String
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  quote     Quote?     @relation(fields: [quoteId], references: [id])
  lineItems LineItem[]
  payments  Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  amountPaise   Int
  method        String
  paidAt        DateTime
  createdAt     DateTime @default(now())

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model LineItem {
  id             String  @id @default(cuid())
  description    String
  quantity       Int
  unitPricePaise Int
  hsnCode        String
  gstRate        Float
  gstAmountPaise Int
  totalPaise     Int

  quoteId   String?
  invoiceId String?

  quote   Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

